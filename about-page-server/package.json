{
  "name": "microfrontends-unravelling-spaghetti-about-page-server",
  "version": "1.0.11",
  "description": "",
  "type": "module",
  "exports": "./src/about-page-server.js",
  "main": "./src/about-page-server.js",
  "bin": {
    "about-page-server": "src/run-about-page-server.js"
  },
  "types": "./types/src/about-page-server.d.ts",
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "src",
    "types",
    "dist"
  ],
  "config": {
    "docker_node_version": "16.3.0"
  },
  "scripts": {
    "start": "node src/run-about-page-server.js",
    "build": "concurrently -r 'npm:build:*'",
    "build:typescript": "rm -rf types && tsc && cp src/*.d.ts types/src",
    "build:public": "node ./dev/generate-html.js ./public about-page-server-client.js index.html",
    "build:docker": "DOCKER_BUILDKIT=1 docker build -t giltayar/microfrontends-unravelling-spaghetti-about-page-server:${npm_package_version} --secret id=npmrc,src=$(npm get userconfig) --build-arg NODE_VERSION=${npm_package_config_docker_node_version} .",
    "test": "FULL_TEST=1 concurrently -r 'npm:test:*'",
    "test:eslint": "eslint --max-warnings=0 --color '**/*.js'",
    "test:typescript": "tsc --noEmit --emitDeclarationOnly false --pretty",
    "postpublish": "concurrently -r 'npm:publish:*'",
    "publish:docker": "docker push giltayar/microfrontends-unravelling-spaghetti-about-page-server:${npm_package_version}"
  },
  "keywords": [
    "javascript",
    "nodejs",
    "microfrontends"
  ],
  "author": "Gil Tayar <gil@tayar.org>",
  "license": "MIT",
  "repository": {
    "url": "https://github.com/giltayar/microfrontends-unravelling-spaghetti",
    "directory": "about-page-server",
    "type": "git"
  },
  "devDependencies": {
    "@jspm/generator": "^1.0.2",
    "@types/node": "^18.13.0",
    "@types/react-dom": "^18.0.11",
    "@types/uuid": "^9.0.0",
    "concurrently": "^7.6.0",
    "eslint": "^8.34.0",
    "eslint-plugin-mocha-no-only": "^1.1.1",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.2.1",
    "p-retry": "^5.1.2",
    "prettier": "^2.8.4",
    "typescript": "^4.9.5",
    "uuid": "^9.0.0"
  },
  "dependencies": {
    "@fastify/static": "^6.9.0",
    "@seasquared/functional-commons": "^1.1.7",
    "close-with-grace": "^1.1.0",
    "fastify": "^4.13.0",
    "fastify-helmet": "^7.1.0",
    "htm": "^3.1.1",
    "microfrontends-unravelling-spaghetti-about-page": "^1.0.10",
    "pino": "^8.10.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
